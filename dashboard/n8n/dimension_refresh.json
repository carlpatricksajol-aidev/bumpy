    { "parameters": { "url": "=https://graph.facebook.com/v22.0/{{ $env.META_AD_ACCOUNT }}/ads?fields=id,creative{thumbnail_url,video_id,effective_object_story_id,instagram_permalink_url}&filtering=[{\"field\":\"ad.effective_status\",\"operator\":\"IN\",\"value\":[\"ACTIVE\"]}]&limit=200&access_token={{ $env.META_ACCESS_TOKEN }}", "options": { "pagination": { "pagination": { "parameters": { "parameters": [ { "name": "after", "value": "={{ $response.body.paging?.cursors?.after }}" } ] }, "paginationCompleteWhen": "other", "completeExpression": "={{ !$response.body.paging?.cursors?.after }}", "requestInterval": 800 } } } }, "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.3, "position": [400, 420], "id": "e5000000-0000-4000-8000-00000000000b", "name": "Creative Meta", "retryOnFail": true, "waitBetweenTries": 5000 },
    { "parameters": { "jsCode": "const C=$('Creative Country').all().flatMap(p=>p.json.data||[]);\nconst D=$('Creative Device').all().flatMap(p=>p.json.data||[]);\nconst A=$('Creative Meta').all().flatMap(p=>p.json.data||[]);\nfunction dev(x){const s=(x||'').toLowerCase();if(s.includes('android'))return 'Android';if(s.includes('iphone')||s.includes('ipad'))return 'iOS';if(s==='desktop')return 'Desktop';if(s.includes('mobile_web'))return 'Mobile Web';return 'Other';}\nconst cm={},dm={};\nfor(const r of C){const id=r.ad_id;if(!id||!r.country)continue;(cm[id]??={})[r.country]=(cm[id][r.country]||0)+parseFloat(r.spend||0);}\nfor(const r of D){const id=r.ad_id;if(!id||!r.impression_device)continue;const k=dev(r.impression_device);(dm[id]??={})[k]=(dm[id][k]||0)+parseFloat(r.spend||0);}\nconst top=o=>o?Object.entries(o).sort((a,b)=>b[1]-a[1])[0]?.[0]||null:null;\nreturn A.map(ad=>{const cr=ad.creative||{};let permalink=cr.instagram_permalink_url||null;if(!permalink&&cr.effective_object_story_id)permalink='https://www.facebook.com/'+cr.effective_object_story_id;return {json:{id:ad.id,primary_country:top(cm[ad.id]),primary_device:top(dm[ad.id]),country_breakdown:cm[ad.id]||null,device_breakdown:dm[ad.id]||null,thumbnail_url:cr.thumbnail_url||null,permalink,video_id:cr.video_id||null}};});" }, "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [620, 420], "id": "e5000000-0000-4000-8000-00000000000c", "name": "Build Creative patch" },
