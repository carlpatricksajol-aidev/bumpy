    { "parameters": { "jsCode": "const C=$('Campaign Country').all().flatMap(p=>p.json.data||[]);\nconst D=$('Campaign Device').all().flatMap(p=>p.json.data||[]);\nfunction dev(x){const s=(x||'').toLowerCase();if(s.includes('android'))return 'Android';if(s.includes('iphone')||s.includes('ipad'))return 'iOS';if(s==='desktop')return 'Desktop';if(s.includes('mobile_web'))return 'Mobile Web';return 'Other';}\nconst e={};\nfor(const r of C){const id=r.campaign_id;if(!id||!r.country)continue;(e[id]??={c:{},d:{}}).c[r.country]=(e[id].c[r.country]||0)+parseFloat(r.spend||0);}\nfor(const r of D){const id=r.campaign_id;if(!id||!r.impression_device)continue;const k=dev(r.impression_device);(e[id]??={c:{},d:{}}).d[k]=(e[id].d[k]||0)+parseFloat(r.spend||0);}\nconst top=o=>Object.entries(o).sort((a,b)=>b[1]-a[1])[0]?.[0]||null;\nreturn Object.entries(e).map(([id,v])=>({json:{id,primary_country:top(v.c),primary_device:top(v.d),country_breakdown:Object.keys(v.c).length?v.c:null,device_breakdown:Object.keys(v.d).length?v.d:null}}));" }, "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [400, 0], "id": "e5000000-0000-4000-8000-000000000003", "name": "Build Campaign patch" },
