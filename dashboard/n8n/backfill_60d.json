    {
      "parameters": {
        "jsCode": "function actVal(a,t){if(!Array.isArray(a))return 0;for(const x of t){const f=a.find(i=>i.action_type===x);if(f&&f.value!=null)return parseFloat(f.value);}return 0;}\nconst P=['omni_purchase','purchase','offsite_conversion.fb_pixel_purchase','app_custom_event.fb_mobile_purchase'];\nconst I=['mobile_app_install','omni_app_install','app_install'];\nreturn $input.all().map(({json:c})=>{const spend=parseFloat(c.spend||0);const conv=actVal(c.actions,P);const rev=actVal(c.action_values,P);let roas=0;if(Array.isArray(c.purchase_roas)&&c.purchase_roas.length)roas=parseFloat(c.purchase_roas[0].value||0);else roas=spend>0?rev/spend:0;return {json:{campaign_id:c.campaign_id,date:c.date_start,spend:Math.round(spend*100)/100,revenue:Math.round(rev*100)/100,impressions:parseInt(c.impressions||0),reach:parseInt(c.reach||0),clicks:parseInt(c.clicks||0),link_clicks:parseInt(c.inline_link_clicks||0),unique_link_clicks:parseInt(c.unique_inline_link_clicks||0),conversions:Math.round(conv),app_installs:Math.round(actVal(c.actions,I)),frequency:Math.round(parseFloat(c.frequency||0)*100)/100,purchase_roas:Math.round(roas*10000)/10000}};});"
